# FanchmWrt for JDCloud RE-SP-01B (京东云无线宝一代 / MT7621) —— 精简版配置
# 用法：cp config/re-sp-01b-minimal.seed fanchmwrt/.config && cd fanchmwrt && make defconfig
#
# 设计目标：镜像体积控制在 ~14-18MB，稳稳装进 27MB 的 firmware 分区。
# 完整版 DPI / OAF 特征库 / LuCI 全家桶不进镜像，刷机后通过 eMMC extroot 再装。

## 版本标识（影响镜像文件名前缀，去掉则回到 openwrt- 前缀）
CONFIG_VERSION_DIST="FanchmWrt"

## 根密码（空字符串 = 无密码，LuCI 可直接进；SSH 需先 passwd 设密）
## 同时 files/etc/shadow 也强制置空，双保险
CONFIG_TARGET_ROOTFS_ROOT_PASSWORD=""

## 目标平台
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

## 镜像与根文件系统（NOR 闪存，squashfs）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
# 生成 Image Builder，方便以后不重新编译就换包组合
CONFIG_IB=y
# 不生成 SDK（体积巨大，MIPS 上用不到）
# CONFIG_SDK is not set
# 不生成 VDI/VMDK 之类无关镜像
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VDI_IMAGES is not set

## 构建选项：关掉一切吃体积的东西
# CONFIG_ALL is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_DEVEL is not set
# CONFIG_BUILD_PATENTED is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_PACKAGE_kmod-crypto-test is not set
# 精简文档/手册
# CONFIG_PACKAGE_manpages is not set

## LuCI（默认 uhttpd，不上 SSL 证书依赖以省体积）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
# luci-app-ttyd / luci-app-statistics 等按需自行在 menuconfig 里开
# CONFIG_PACKAGE_luci-app-ttyd is not set

## 文件管理器 / 应用商店（第三方，由 build.sh 注入：istore feed + package/ 克隆）
## 这些是第三方包，对本快照基线（kernel 6.12 + apk）属「尽力编译」：
## 若云端报某包装不上或 image is too big，把下面 3 行注释掉重推即可。
CONFIG_PACKAGE_luci-app-ksmbd=y           # SMB 文件共享（官方源，稳）
CONFIG_PACKAGE_luci-app-fileassistant=y   # 网页文件管理器（kenzok78，第三方）
CONFIG_PACKAGE_luci-app-store=y           # iStore 应用商店（第三方）

## 无线（设备默认已带 kmod-mt7603 + kmod-mt7615-firmware + kmod-mmc-mtk + kmod-usb3）
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y

## 存储 / eMMC / extroot（一代机身自带 64~128GB eMMC，走 /dev/mmcblk0）
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

## USB 存储（USB3.0 口插 U 盘 / 移动硬盘）
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_usbutils=y

## 网络与日常工具（保持克制，需要再加）
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_openssh-sftp-server=y

## IPv6 / DHCP 基础（LuCI 会依赖，保持默认开启）

# ---------------------------------------------------------------------------
# 可选追加：想把完整 DPI 组件直接编进镜像时，把下面这段注释打开，
# 但要注意 27MB 上限——make 报 "image is too big" 就说明塞不下了，
# 请改回精简版 + eMMC 扩展（见 scripts/extroot-emmc.sh）。
